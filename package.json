{
	"name": "transformer-explainer",
	"version": "0.0.1",
	"scripts": {
		"prepare": "svelte-kit sync",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"deploy": "gh-pages -d build --nojekyll",
		"deploy-temp": "gh-pages -d build --nojekyll --repo https://github.com/aereeeee/te-temp.git",
		"check:workshop": "tsc --noEmit -p tsconfig.workshop.json",
		"test:workshop": "node --test scripts/workshop-check.test.mjs scripts/workshop-runtime.test.mjs scripts/workshop-snapshot.test.mjs scripts/textbook-navigation.test.mjs scripts/array-reshape.test.mjs scripts/vector-canvas-reactivity.test.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@neoconfetti/svelte": "^1.0.0",
		"@sveltejs/adapter-auto": "^3.2.0",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.53.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/d3": "^7.4.3",
		"@types/d3-sankey": "^0.12.4",
		"@typescript-eslint/eslint-plugin": "^8.71.2",
		"@typescript-eslint/parser": "^8.71.2",
		"autoprefixer": "^10.4.16",
		"bignumber.js": "^9.1.2",
		"classnames": "^2.5.1",
		"d3": "^7.9.0",
		"d3-color": "^3.1.0",
		"d3-sankey": "^0.12.3",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^3.23.1",
		"flowbite": "^2.3.0",
		"flowbite-svelte": "^0.46.1",
		"flowbite-svelte-icons": "^1.6.1",
		"gh-pages": "^6.1.1",
		"globals": "^17.13.0",
		"postcss": "^8.4.33",
		"prettier": "^3.1.1",
		"prettier-plugin-svelte": "^3.1.2",
		"prettier-plugin-tailwindcss": "^0.5.1",
		"sass": "^1.77.1",
		"svelte": "^5.53.5",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^3.4.1",
		"tslib": "^2.4.1",
		"typescript": "^5.0.0",
		"vite": "^6.3.0"
	},
	"type": "module",
	"dependencies": {
		"@xenova/transformers": "^2.17.1",
		"gsap": "^3.12.5",
		"katex": "^0.18.2",
		"onnxruntime-web": "^1.23.0"
	},
	"engines": {
		"node": "^20.19.0 || ^22.13.0 || >=24.0.0",
		"npm": ">=10.0.0"
	},
	"overrides": {
		"cookie": "^0.7.2",
		"postcss-selector-parser": "^7.1.6",
		"protobufjs": "^7.6.5",
		"sharp": "^0.35.5",
		"sucrase": "^3.35.1"
	}
}
